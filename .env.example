# Copy to .env.local (or set in the hosting dashboard) and fill in at launch.
# Leave a value as REPLACE_… to keep that destination off. With none set, the form works
# locally in dev (leads are logged to the server console) and shows an error in production.

# Supabase project used by the previous site (table: registrations — name, phone, track)
# SUPABASE_KEY is the publishable/anon key; the table's RLS policy allows anonymous inserts.
SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
SUPABASE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Google Apps Script web-app URL that appends { name, phone, track } to the sheet
GOOGLE_SHEETS_WEBHOOK_URL=REPLACE_WITH_APPS_SCRIPT_URL

# Telegram bot that posts each application to the admin chat
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
